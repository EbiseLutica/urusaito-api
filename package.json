{
  "name": "urusaito-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy src/index.ts",
    "start": "wrangler dev src/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply urusaito --local",
    "db:migrate:remote": "wrangler d1 migrations apply urusaito --remote",
    "db:seed:local": "wrangler d1 execute urusaito --local --file=seeds/gyagus.sql",
    "db:seed:remote": "wrangler d1 execute urusaito --remote --file=seeds/gyagus.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "hono": "^4.13.13"
  }
}
